# .env da instância Estoque Logística (2026-10-21) — copie para
# /opt/estoque-logistica/.env e preencha. Ver DEPLOY-LINUX.md, seção
# "Segunda instância". Este .env é SÓ desta instância: banco, emails e
# porta não têm nada a ver com os da Central.

# Só o módulo Estoque (Dashboard, Descarte, Atualizar). Pra ligar também as
# abas Termos e Equipamentos móveis: APP_MODULOS=estoque,estoque-termos,estoque-moveis
APP_MODULOS=estoque
APP_NOME=Estoque Logística

# Porta interna (o Caddy publica em https://dsp-lif.local:8443). Precisa
# bater com Environment=PORT do deploy/estoque-logistica.service.
PORT=3001

# Login com Microsoft — mesmo App Registration da Central; cadastre também
# https://dsp-lif.local:8443/api/auth/entra/callback como Redirect URI.
APP_BASE_URL=https://dsp-lif.local:8443
COOKIE_SECURE=true
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Email (botão "Enviar resumo por email agora" e envios agendados).
# MAIL_FROM pode ser a mesma caixa da Central; os destinatários são os do
# outro departamento.
MAIL_FROM=
MAIL_TO=
# RESUMO_ESTOQUE_TO=
# RESUMO_ESTOQUE_CC=
# LEMBRETE_ESTOQUE_TO=

# Backup e monitor desta instância.
BACKUP_PREFIXO=estoque-logistica-
MONITOR_SERVICO=estoque-logistica
# MONITOR_ALERTA_TO=ian.alves@telehelp.com.br
