# Site do Caddy — @NOME@. Gerado por scripts/instalar-instancia-estoque.sh
# como /etc/caddy/estoque-@SLUG@.caddy e incluído no /etc/caddy/Caddyfile da
# Central por uma linha "import" (o site da Central não muda).
#
# Endereço: https://@NOME_DNS@ (porta 443, ao lado da Central — o Caddy
# escolhe o site pelo nome). Precisa do registro DNS interno apontando pro
# servidor. Mesma CA interna do Caddy — quem já confia no certificado da
# Central não vê aviso novo.

@NOME_DNS@ {
	tls internal

	reverse_proxy localhost:@PORTA@

	encode gzip
}

# Endereço antigo (IP + porta) — só redireciona pro nome, pra favoritos
# salvos antes da troca continuarem funcionando.
192.168.62.194:@PORTA_HTTPS@ {
	tls internal

	redir https://@NOME_DNS@{uri} permanent
}
