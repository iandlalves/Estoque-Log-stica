# .env da instância @NOME@ — gerado por scripts/instalar-instancia-estoque.sh
# a partir de deploy/estoque-instancia.env.template (valores por instância
# em deploy/instancias.conf). Este .env é SÓ desta instância: banco, emails
# e porta não têm nada a ver com os da Central nem das outras instâncias.
# Ver DEPLOY-LINUX.md, seção 9.

# Só o módulo Estoque (Dashboard, Descarte, Atualizar). Pra ligar também as
# abas Termos e Equipamentos móveis: APP_MODULOS=estoque,estoque-termos,estoque-moveis
APP_MODULOS=estoque
APP_NOME=@NOME@

# Porta interna (o Caddy publica em https://@NOME_DNS@).
# Precisa bater com Environment=PORT do serviço estoque-@SLUG@.
PORT=@PORTA@

# Login com Microsoft — mesmo App Registration da Central; cadastre também
# https://@NOME_DNS@/api/auth/entra/callback como Redirect URI.
APP_BASE_URL=https://@NOME_DNS@
COOKIE_SECURE=true
# Nome do cookie de sessão — único por instância. Com um nome DNS por
# instância os cookies já ficam separados; isto garante o mesmo se alguém
# acessar pelo IP (o navegador não separa cookie por porta).
COOKIE_NOME=sessao_@SLUG@
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Email (botão "Enviar resumo por email agora" e envios agendados).
# MAIL_FROM pode ser a mesma caixa da Central; os destinatários são os do
# departamento desta instância.
MAIL_FROM=
MAIL_TO=
# RESUMO_ESTOQUE_TO=
# RESUMO_ESTOQUE_CC=
# LEMBRETE_ESTOQUE_TO=

# Backup e monitor desta instância.
BACKUP_PREFIXO=estoque-@SLUG@-
MONITOR_SERVICO=estoque-@SLUG@
# MONITOR_ALERTA_TO=ian.alves@telehelp.com.br
